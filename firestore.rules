rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Services Catalog (Readable by all, writeable by admin)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.admin == true;
    }

    // Hubs (Readable by all customers for coverage check)
    match /hubs/{hubId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.admin == true;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAuthenticated();
    }

    // Customer Profiles & Saved Addresses
    match /users/{userId} {
      allow read, write: if true;

      match /addresses/{addressId} {
        allow read, write: if true;
      }
    }

    // Support tickets
    match /support_tickets/{ticketId} {
      allow read, create: if true;
      allow update: if isAuthenticated();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read, create: if true;
      allow update: if true;
    }

    // Cross-Hub Booking Attempts & Pune Hubs Admin Leads
    match /cross_hub_attempts/{attemptId} {
      allow read, write: if true;
    }
  }
}
